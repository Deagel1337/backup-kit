{
    "name": "deagel1337/backup-kit",
    "description": "Classes for creating backups",
    "type": "library",
    "license": "MIT",
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.2",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "Deagel1337\\Backup\\Kit\\": "src/"
        },
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Yehor Strakhov",
            "email": "yehor.strakhov@th-nuernberg.de"
        },
        {
            "name": "Yehor Strakhov",
            "email": "yehor.strakhov@outlook.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "vlucas/phpdotenv": "^5.7",
        "symfony/console": "^7.4",
        "phpdocumentor/shim": "^3.10"
    },
    "config": {
        "allow-plugins": {
            "phpdocumentor/shim": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests",
        "format": "pint",
        "check": [
            "@format",
            "@analyse",
            "@test"
        ]
    }
}
