#!/usr/bin/env php
<?php

declare(strict_types=1);

use Backup\Php\Application\Archive\ArchiveApplication;
use Backup\Php\Archive\Driver\BorgArchiveDriver;
use Backup\Php\Archive\Driver\DockerArchiveDriver;
use Backup\Php\Archive\Model\ArchiveInfo;
use Backup\Php\Console\Application;
use Backup\Php\Context\DockerContainerContext;
use Backup\Php\DatabaseBackup\Driver\MariaDbBackupDriver;
use Backup\Php\DatabaseBackup\Model\DatabaseConnection;
use Backup\Php\Services\ArchiveService;
use Dotenv\Dotenv;

require_once __DIR__ . '/../vendor/autoload.php';

$dotenv = Dotenv::createImmutable(__DIR__ . '/../src');
$dotenv->load();

$repository = $_ENV['BORG_REPOSITORY'] ?? '';

$borgDriver = new BorgArchiveDriver(
    repository: $repository,
    passphrase: $_ENV['BORG_PASSPHRASE'] ?? '',
    sshPort: (int) ($_ENV['BORG_SSH_PORT'] ?? 22),
);

$archiveInfo = new ArchiveInfo(
    path: $repository,
    driver: 'borg',
    format: 'borg',
);

$context = new DockerContainerContext(
    "wp_e_beratungsinstitut_de_data", 
    "wp_e_beratungsinstitut_de_data", 
    "/var/www/html/wp-content", 
    "."
);

$dockerDriver = new DockerArchiveDriver($context);

$archiveApplication = new ArchiveApplication(
    new ArchiveService($borgDriver),
);

$dockerArchiveApplication = new ArchiveApplication(
        new ArchiveService($dockerDriver),
);

$connection = new DatabaseConnection(
    driver: 'mariadb',
    host: 'localhost',
    port: 6033,
    database: 'dev-db',
    username: 'devuser',
    password: 'devpass'
);

$databaseDriver = new MariaDbBackupDriver(
    $connection
);

if($archiveInfo === null || $borgDriver == null || $dockerDriver == null) {
        throw new RuntimeException(
            sprintf("Bitte einen gültigen Driver eingeben")
        );
}

$application = new Application(
    borgArchive: $archiveApplication,
    dockerArchive: $dockerArchiveApplication,
    repository: $archiveInfo,
    driver: $databaseDriver,
);
try {
    $application->run();
} catch (Throwable $exception) {
    fwrite(STDERR, sprintf(
        "%s: %s\n%s\n",
        $exception::class,
        $exception->getMessage(),
        $exception->getTraceAsString(),
    ));

    exit(1);
}
